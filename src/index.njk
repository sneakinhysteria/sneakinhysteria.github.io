---
layout: base.njk
permalink: /
---

<section class="intro">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
</section>

<ul class="post-list">
  {% for post in collections.posts %}
    <li class="card">
      {% if post.data.image %}
        <a class="card-image" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
          <img src="{{ post.data.image }}" alt="" loading="lazy" />
        </a>
      {% endif %}
      <div class="card-body">
        <p class="meta">
          <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
          {% for tag in post.data.tags %}{% if tag != "posts" %}
            <a class="tag" href="/tag/{{ tag }}/">{{ tag | tagName }}</a>
          {% endif %}{% endfor %}
        </p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="summary">{{ post.data.excerpt or (post.content | summary) }}</p>
      </div>
    </li>
  {% endfor %}
</ul>
