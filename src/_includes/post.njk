---
layout: base.njk
---

<article class="post">
  <header class="post-header">
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {% for tag in tags %}{% if tag != "posts" %}
        <a class="tag" href="/tag/{{ tag }}/">{{ tag | tagName }}</a>
      {% endif %}{% endfor %}
    </p>
    <h1>{{ title }}</h1>
    {% if excerpt %}<p class="lede">{{ excerpt }}</p>{% endif %}
  </header>

  {% if image %}
    <figure class="feature">
      <img src="{{ image }}" alt="" loading="eager" />
    </figure>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>
</article>

<nav class="post-nav" aria-label="More posts">
  <a href="/">← All posts</a>
</nav>
