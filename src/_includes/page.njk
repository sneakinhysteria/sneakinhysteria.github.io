---
layout: base.njk
---

<article class="post page">
  <header class="post-header">
    <h1>{{ title }}</h1>
    {% if excerpt %}<p class="lede">{{ excerpt }}</p>{% endif %}
  </header>

  {% if image %}
    <figure class="feature">
      <img src="{{ image }}" alt="" loading="eager" />
    </figure>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
