<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title }}</title>
    <description>{{ site.description }}</description>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/rss/" rel="self" type="application/rss+xml"/>
    <language>{{ site.locale }}</language>
    {%- if collections.posts | length %}
    <lastBuildDate>{{ collections.posts[0].date.toUTCString() }}</lastBuildDate>
    {%- endif %}
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ post.url | absolute }}</link>
      <guid isPermaLink="true">{{ post.url | absolute }}</guid>
      <dc:creator>{{ site.author }}</dc:creator>
      <pubDate>{{ post.date.toUTCString() }}</pubDate>
      {%- if post.data.excerpt %}
      <description>{{ post.data.excerpt }}</description>
      {%- endif %}
      <content:encoded><![CDATA[{{ post.content | safe }}]]></content:encoded>
      {%- for tag in post.data.tags %}{% if tag != "posts" %}
      <category>{{ tag | tagName }}</category>
      {%- endif %}{% endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
