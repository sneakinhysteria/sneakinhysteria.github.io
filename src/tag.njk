---
layout: base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: entry
permalink: "/tag/{{ entry.tag }}/"
eleventyComputed:
  title: "{{ entry.name }}"
---

<section class="intro">
  <h1>{{ entry.name }}</h1>
  <p>{{ entry.count }} post{% if entry.count != 1 %}s{% endif %}</p>
</section>

<ul class="post-list">
  {% for post in collections.posts %}
    {% if entry.tag in post.data.tags %}
      <li class="card">
        {% if post.data.image %}
          <a class="card-image" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
            <img src="{{ post.data.image }}" alt="" loading="lazy" />
          </a>
        {% endif %}
        <div class="card-body">
          <p class="meta">
            <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
          </p>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p class="summary">{{ post.data.excerpt or (post.content | summary) }}</p>
        </div>
      </li>
    {% endif %}
  {% endfor %}
</ul>
